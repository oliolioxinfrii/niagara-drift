# Volcano retained-depth gesture QA: keys 1-12 have hold/latch/tap behavior.
# Keys 13-16 now trigger GHOST events and do NOT change latched macro amounts.
notips
set 52 0
set 70 0
set 74 0
tap PLAY
set 55 0
set 75 0
wait 200
# CHORD (key 10 / g5): release latches the intensity without SEL.
key w9 down
wait 350
key w9 up
wait 400
expect gam5 100
# A tap begins the return to zero.
tapkey w9
wait 400
expect gam5 0
# STUTTER (key 12 / g7): release remains latched; a tap returns.
key w11 down
wait 350
key w11 up
wait 300
expect gam7 100
tapkey w11
wait 400
expect gam7 0
# GHOST STRIKE / SCRAPE / BOW / TREMOR are events, not old macros.
tapkey w12
tapkey w13
tapkey w14
tapkey w15
expect gam0 0
expect gam1 0
expect gam2 0
expect gam3 0
