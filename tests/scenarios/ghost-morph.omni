# Final-voice candidate: fixed 50% Cross+Body / Terrain+Body hybrid.
notips
expect ghostblend 50
expect ghostmode 14

# SEL+PRESETS must not change the timbre; PRESETS alone remains Morph Time.
press SEL
spin PRESET -100
wait 60
expect ghostblend 50
spin PRESET 100
wait 60
expect ghostblend 50
release SEL

# GHOST MIX remains a saved/morphable sound parameter.
set 112 50
expect par112 50
press SEL
spin PRESET -100
wait 60
expect ghostblend 50
expect par112 50
release SEL

# STRESS must preserve the fixed timbre and not change GHOST MIX.
press SEL
tap REC
release SEL
expect ghostblend 50
expect par112 50
