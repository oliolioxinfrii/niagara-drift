# Volcano: the former pressure-sensitive keys now use hold duration only.
notips
set 70 0
set 52 0
tap PLAY
wait 100
# Pressure does not determine Snarl's depth.
pressure w10 0
key w10 down
wait 350
expect gam6 100
key w10 up
wait 150
expect gam6 100
# A quick tap starts returning to zero, without SEL or another latch.
tapkey w10
wait 400
expect gam6 0
# Stutter obeys the same press/hold/release rule.
pressure w11 127
key w11 down
wait 350
key w11 up
wait 150
expect gam7 100
tapkey w11
wait 400
expect gam7 0
# The lower pads are not scene-store shortcuts.
bank 0
press SAVE
key w9 down
wait 350
key w9 up
release SAVE
wait 300
expect scenes 0
