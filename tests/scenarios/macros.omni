# Volcano gesture regression: Morph Time governs all gestures; releasing
# a held gesture latches its depth, and tapping an active key returns to zero.
# Verify each macro's DSP effect, plus Wander, Age and persistence.
notips
set 7 700
set 28 680
set 11 75
set 32 61
bank 0
set 70 0                  # fastest Morph Time, so a 350 ms hold reaches full
set 74 0                  # pitch lock off for Shift
tap PLAY
wait 1000
expect heard7 700
expect gam0 0
expect gam1 0
expect gam2 0
expect gam3 0

# WEIGHT: warmth and sub; a release keeps the full amount.
key w12 down
wait 350
key w12 up
wait 300
expect gam0 100
expect par90 100
expect heard5 >42
expect heard7 <700
expect heard17 0
# A tap explicitly returns Weight; a release alone never does.
tapkey w12
wait 500
expect gam0 0
expect par90 0
expect heard5 30
expect heard7 700
expect heard17 85

# SHIFT: the two pitches move together at full depth.
set 80 200
key w13 down
wait 350
key w13 up
wait 300
expect gam1 100
expect par91 100
expect mpitch0 <-250
expect mpitch1 <-250
tapkey w13
wait 500
expect gam1 0
expect par91 0
expect mpitch0 0
expect mpitch1 0

# CLEAN: suppress drive, character, and delay wet signal; restore on tap.
set 77 60
set 10 50
set 62 50
wait 300
key w14 down
wait 350
key w14 up
wait 300
expect gam2 100
expect par92 100
expect heard77 0
expect heard10 0
expect heard62 0
tapkey w14
wait 500
expect gam2 0
expect par92 0
expect heard77 60
expect heard62 50
set 77 0
set 10 20
set 62 25

# WASH: raise delay repeats and mix towards their capped targets.
set 61 70
set 62 60
wait 300
key w15 down
wait 350
key w15 up
wait 300
expect gam3 100
expect par93 100
expect heard61 80
expect heard62 70
expect heard63 >60
expect heard17 28
expect heard38 -28
# Persist the latch using the project save path, then reboot.
save
wait 500
reboot
wait 500
expect par93 100
expect gam3 100
expect heard63 >60
tapkey w15
wait 500
expect gam3 0
expect par93 0
expect heard61 70
expect heard62 60
set 61 50
set 62 25

# WANDER: drone II's melody leaves its pitch and then returns.
set 78 60
wait 7000
expect wander >150
set 78 0
wait 30000
expect wander 0

# AGE: the filter darkens and recovers over approximately 20 seconds.
set 79 100
wait 21000
expect heard7 450
set 79 0
wait 21000
expect heard7 700

# An inactive drone remains muted even at full Weight.
set 32 0
wait 500
key w12 down
wait 350
key w12 up
wait 300
expect gam0 100
expect heard32 0
expect lvl1 -99
tapkey w12
wait 500
expect gam0 0
