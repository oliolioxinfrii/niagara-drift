# Focused LFO pause/resume/stop key regression.
# b8=C#5 on every non-note-entry page. b4 retains drone-II filter routing.
notips
set 39 0
set 67 0                       # legacy LFO-to-Swell parameter is no longer a key action
set 45 0
set 47 104                      # LFO period short enough for a 5 s stop test
set 55 1                        # Swell enabled (transport also returns both envelopes)
tap LFO
expect view 6
tapkey b4
expect par39 1
tapkey b4
expect par39 2
tapkey b4
expect par39 0
tapkey b8
expect lfo_transport 1
expect par67 0
wait 450
expect lfo_transport 1
tapkey b8
expect lfo_transport 0
wait 450
# Long press rewinds both waveforms and Swell phases at the LFO rate,
# leaves the transport stopped, without reviving the old lock.
key b8 down
wait 700
key b8 up
expect par67 0
wait 5000
expect lfo_transport 1
expect lfo_phase 0
expect swell1_phase 0
expect swell2_phase 0
tapkey b8
expect lfo_transport 0
tap LFO
expect view 7
tapkey b8
expect lfo_transport 1
tap LFO
expect view 8
tapkey b8
expect lfo_transport 0
tap HOME
expect view 0
# The same physical key works in normal and LFO contexts; D#4 stays Pitch Link.
tapkey b8
expect lfo_transport 1
expect par45 0
tapkey b8
expect lfo_transport 0
tapkey b4
expect par45 1
tapkey b4
expect par45 0
