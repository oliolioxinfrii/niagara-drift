# External MIDI notes: two triggered drones, never an FM-1 physical-key remap.
# MIDI note values: C2=0x24 (36), C3=0x30 (48),
# B3=0x3B (59), B2=0x2F (47), C4=0x3C (60).
# FADE=0 is 50ms; MIDI pitch must not modify project parameters.
notips
set 51 0
set 50 80
# Even with global GLIDE high, each new MIDI pitch starts at its final
# note after the old key has finished its FADE release.
set 0 4500
set 21 5700
set 45 1
set 55 0
expect playing 0
expect midimode 0
expect midiui 0

# Note On cannot commandeer ordinary PLAY mode. MIDI is an explicit
# session mode, not a consequence of connecting/playing a controller.
midi 90 24 64
wait 100
expect midiui 0
expect midimode 0
expect par0 4500

# Even if sequence is already playing, entering MIDI mode stops it
# while preserving the authored note data.
press SEL
tap PLAY
release SEL
wait 100
expect seqstate 1

# SEL+GLO starts both LFO transport and Swell, without starting
# either drone or changing the saved Swell and pitch parameters.
press SEL
tap GLO
release SEL
wait 300
expect midiui 1
expect midimode 1
expect playing 1
expect seqstate 0
expect view 0
expect par55 0
expect midigate0 0
expect midigate1 0
expect swell1_phase >0
expect lfo_phase >0

# C2 first -> drone I; C3 second -> drone II; PITCH LINK ignored
# for the external MIDI control while project settings are preserved.
midi 90 24 64
wait 100
expect midimode 1
expect midinote0 36
expect midinote1 -1
expect midigate0 1
expect midigate1 0
expect playing 0
midi 90 30 64
wait 100
expect midinote0 36
expect midinote1 48
expect midigate1 1
expect pitch0 3600
expect pitch1 4800

# A third note waits silently, never stealing a held key. Releasing
# that waiting note before either assigned note cancels the request.
midi 90 3C 64
wait 20
expect midinote0 36
expect midinote1 48
expect midiwait 60
midi 80 3C 00
wait 20
expect midiwait -1

# Release C3 and replace exactly drone II, AFTER the 50ms fade.
midi 80 30 00
wait 18
expect midigate1 0
midi 90 3B 64
wait 18
expect midinote1 48
expect midipending1 59
wait 130
expect midinote1 59
expect midigate1 1
expect midipending1 -1
expect midinote0 36

# Release C2 while B3 remains held: B2 must take drone I.
midi 90 24 00
wait 18
expect midigate0 0
midi 90 2F 64
wait 18
expect midinote0 36
expect midipending0 47
wait 130
expect midinote0 47
expect midigate0 1
expect midinote1 59
expect midipending0 -1

# Note Off for a non-held key does nothing.
midi 80 24 00
wait 20
expect midigate0 1
expect midigate1 1

# A third note pressed BEFORE release takes whichever slot is
# released first. Here B2 (Drone I) is released: waiting C4 takes I,
# while B3 (Drone II) continues.
midi 90 3C 64
wait 20
expect midiwait 60
expect midinote0 47
expect midinote1 59
midi 80 2F 00
wait 20
expect midigate0 0
expect midipending0 60
expect midiwait -1
wait 130
expect midinote0 60
expect midinote1 59
expect midigate0 1

# Release both, reassign first subsequent note to Drone I.
midi 80 3C 00
midi 80 3B 00
wait 110
expect midigate0 0
expect midigate1 0
midi 90 3E 64
wait 100
expect midinote0 62
expect midigate0 1
expect midigate1 0

# PLAY controls the transport within MIDI mode without changing modes.
# Stopping closes both MIDI gates and ignores notes while stopped.
expect par0 4500
expect par21 5700
tap PLAY
wait 120
expect midimode 1
expect midiui 1
expect playing 0
expect midigate0 0
midi 90 24 64
wait 100
expect midigate0 0

# Restarting MIDI mode keeps both drones silent until the next key press.
tap PLAY
wait 100
expect midiui 1
expect midimode 1
expect playing 1
expect midigate0 0
midi 90 2F 64
wait 120
expect midigate0 1
expect midinote0 47
midi 80 2F 00
wait 120

# SEL+GLO returns to PLAY mode, stopped; no automatic playback.
# The original Swell switch, pitches, and PITCH LINK remain intact.
press SEL
tap GLO
release SEL
wait 250
expect midiui 0
expect midimode 0
expect playing 0
expect seqstate 0
expect par55 0
expect par45 1
expect par0 4500
expect par21 5700

# Plain PLAY now starts the original continuous drones again.
tap PLAY
wait 100
expect playing 1
expect midiui 0
expect midimode 0
# In PLAY mode SEL+OCT once again controls the saved individual switches.
press SEL
tap OCT-
release SEL
wait 100
expect par110 1

