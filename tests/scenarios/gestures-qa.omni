# Volcano gesture QA: key release is always a latch; no SEL modifier.
notips
set 52 0
set 74 0
tap PLAY
set 55 0
set 75 0
wait 200
# Shift stays at its held amount without SEL.
key w13 down
wait 350
key w13 up
wait 400
expect gam1 100
# A tap starts the return.
tapkey w13
wait 400
expect gam1 0
# Wash: held amount persists after key-up.
key w15 down
wait 350
key w15 up
wait 300
expect gam3 100
tapkey w15
wait 400
expect gam3 0
