# SPDX-License-Identifier: GPL-3.0-only
# CPU STRESS: repeatable scratch DSP load; SEL+REC never overwrites a scene.
notips
bank 0
expect bscenes 0
expect seqcount 1
expect seqstate 0
expect ghostmode 14

press SEL
tap REC
release SEL
expect par0 5000
expect par21 5700
expect par112 50
expect par42 2
expect par94 4
expect ghostmode 14
expect ghostmonitor 0
expect ghostmute 0
expect seqcount 1
expect seqtotal 0
expect seqstate 0
expect loop 0
expect bscenes 0

tap PLAY
expect playing 1
wait 1200

# Recalling a second time restores exact parameters and stopped transport.
press SEL
tap REC
release SEL
expect par112 50
expect seqcount 1
expect seqstate 0
expect bscenes 0
expect ghostmode 14

# Unmodified REC remains Motion Loop.
tap REC
expect loop 1
tap REC
expect loop 0
