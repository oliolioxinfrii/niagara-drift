# SPDX-License-Identifier: GPL-3.0-only
# CPU STRESS: repeatable scratch DSP load; SEL+REC never overwrites a scene.
notips
bank 0
expect bscenes 0
expect seqcount 1
expect seqstate 0
expect ghostmode 14

press SEL
tap REC
release SEL
expect par0 5000
expect par21 5700
expect par112 50
expect par42 2
expect par55 1
expect par58 102
expect par64 4
expect par85 -38
expect par94 4
expect par112 50
expect ghostmode 14
expect ghostmonitor 0
expect ghostmute 0
expect seqcount 4
expect seqtotal 20
expect seqphase 17
expect seqnonhome 1
expect seqstate 0
expect loop 0
expect bscenes 0

tap PLAY
expect playing 1
press SEL
tap PLAY
release SEL
expect seqstate 1
wait 1200
expect seqstate 1

# Recalling a second time restores exact parameters and stopped transport.
press SEL
tap REC
release SEL
expect par112 50
expect par55 1
expect seqcount 4
expect seqtotal 20
expect seqstate 0
expect bscenes 0
expect ghostmode 14

# Unmodified REC remains Motion Loop.
tap REC
expect loop 1
tap REC
expect loop 0
