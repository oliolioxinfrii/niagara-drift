# A stopped long PLAY creates a new starting sound without starting audio.
# Ordinary short PLAY and SEL+PLAY retain their meanings.
notips
expect playing 0
expect par53 0
expect par54 60
expect par51 29
expect par74 1
expect par110 0
press PLAY
wait 1100
expect playing 0
expect par53 0
expect par54 60
expect par51 29
expect par74 1
expect par110 0
expect par7 >249
expect par7 <901
expect par8 >99
expect par8 <721
expect par17 >-91
expect par17 <91
expect par16 >0
expect par37 >0
expect par77 >-1
expect par77 <101
release PLAY
expect playing 0
# Starting audio still requires a short tap; long hold must not start it.
tap PLAY
expect playing 1
wait 500
tap PLAY
expect playing 0
# Repeated long holds generate new starting points while stopped.
press PLAY
wait 1100
release PLAY
expect playing 0
# Undo restores the earlier randomized sound, not the starting preset.
press SEL
tap SAVE
release SEL
wait 300
expect playing 0
# The old SEL+PLAY shortcut still operates independently of randomization.
press SEL
tap PLAY
release SEL
expect playing 0
