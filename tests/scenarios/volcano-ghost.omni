# SPDX-License-Identifier: GPL-3.0-only
# CPU1 experiment: only Terrain -> Body (mode 14) remains selectable.
notips
expect par112 0
expect par75 50
expect ghostmode 14
expect ghostmonitor 0
expect ghostmute 0
spin PRESET 1
expect ghostmode 14
press SEL
spin PRESET 4
expect ghostmode 14
spin PRESET -4
expect ghostmode 14
release SEL

# ALGORITHM controls MOVEMENT (75); SEL+ALGORITHM controls GHOST MIX (112).
spin ALGO 25
expect par75 75
expect par112 0
press SEL
spin ALGO 40
expect par112 40
expect par75 75
release SEL
spin ALGO -10
expect par75 65
expect par112 40
spin ALGO -15
expect par75 50
press SEL
spin ALGO 30
expect par112 70
expect par75 50
# The entire dry-to-GHOST crossfade remains reachable, with unchanged
# scene storage and no separate saved mute parameter.
spin ALGO 30
expect par112 100
spin ALGO -30
expect par112 70
release SEL

# Both monitoring shortcuts must preserve the saved GHOST MIX.
press SEL
tapkey w0
expect ghostmonitor 1
expect ghostmute 0
tapkey w1
expect ghostmonitor 1
expect ghostmute 1
expect par112 70
tapkey w0
expect ghostmonitor 0
tapkey w1
expect ghostmute 0
tapkey w1
expect ghostmute 1
release SEL
tapkey w1
expect ghostmute 1
expect par112 70

save
wait 150
reboot
expect par112 70
expect par75 50
expect ghostmode 14
expect ghostmonitor 0
expect ghostmute 0
