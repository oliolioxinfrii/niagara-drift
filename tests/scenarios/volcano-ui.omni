# VOLCANO v1.5: graphics/navigation smoke test. No changes to DSP or stored scenes.
# Run by tests/run_tests.sh, screenshots under build/scenarios/volcano-ui/.
notips
expect view 0
wait 150
shot surface.png
page 1
# Pitch shows scope traces at rest; turning Reso temporarily shows filter curves.
wait 500
shot pitch-scope.png
spin K2 5
shot pitch-resonance.png
wait 650
shot pitch.png
page 2
wait 150
shot life.png
# Character should light lava from the base of the Life cone.
spin K3 100
wait 120
shot life-lava-full.png
