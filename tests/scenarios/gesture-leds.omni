# Gesture LEDs follow the time-controlled amount; releases retain it.
notips
legacykeys
set 52 0
tap PLAY
wait 100
expect ledw9 0
expect ledw10 0
expect ledw12 0
# Hold Chord to full; release retains full brightness.
key w9 down
wait 350
key w9 up
wait 150
expect gam5 100
expect ledw9 255
# Tap starts the return to zero.
tapkey w9
wait 400
expect gam5 0
expect ledw9 0
# Repeat with Snarl to cover the other pressure-sensing keys.
key w10 down
wait 350
key w10 up
wait 150
expect gam6 100
expect ledw10 255
tapkey w10
wait 400
expect gam6 0
expect ledw10 0
